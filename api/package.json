{
  "name": "api",
  "version": "1.0.0",
  "description": "API usando ICW Framework",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "format": "biome format --write",
    "build": "tsc --outDir dist",
    "generate:env": "npx tsx node_modules/@insightcreativewebs/api/scripts/generate-env.ts",
    "generate:module": "npx tsx node_modules/@insightcreativewebs/api/scripts/generate-module.ts",
    "generate:env:example": "npx tsx node_modules/@insightcreativewebs/api/scripts/generate-env.ts --example-only",
    "generate:env:force": "npx tsx node_modules/@insightcreativewebs/api/scripts/generate-env.ts --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@insightcreativewebs/api": "^1.0.9",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "nodemon": "^3.1.9",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
