# ============================================

# ========== Servidor ==========
PORT= # Porta do servidor HTTP | Tipo: number | Default: 3000
NODE_ENV= # Ambiente de execução da aplicação | Tipo: enum | Valores: development | production | test | Default: development
TIMEZONE= # Timezone da aplicação (ex: America/Sao_Paulo, UTC) | Tipo: string | Default: America/Sao_Paulo

# ========== Logger ==========
LOGGING= # Habilita/desabilita logging global | Tipo: boolean | Default: true
DEBUG_MODE= # Habilita modo debug (mostra logs de debug) | Tipo: boolean | Default: false
LOG_PERSIST_MODE= # Modo de persistência de logs: none, memory, file ou both | Tipo: enum | Valores: none | memory | file | both | Default: none
LOG_DIRECTORY= # Diretório onde os logs serão salvos (quando persist mode incluir file) | Tipo: string | Default: logs
MAX_MEMORY_LOGS= # Número máximo de logs mantidos em memória | Tipo: number | Default: 100

# ========== Request Logging ==========
LOG_REQUEST_LEVEL= # Nível de log de requisições: none (desliga), all (todas), errors (apenas erros) | Tipo: enum | Valores: none | all | errors | Default: all

# ========== Database ==========
DB_NAME= # Nome do banco de dados | Tipo: string | ⚠️ OBRIGATÓRIO
DB_HOST= # Host do banco de dados | Tipo: string | Default: localhost
DB_PORT= # Porta do banco de dados | Tipo: number | Default: 3306
DB_USER= # Usuário do banco de dados | Tipo: string | ⚠️ OBRIGATÓRIO
DB_PASSWORD= # Senha do banco de dados | Tipo: string | ⚠️ OBRIGATÓRIO | 🔒 SENSÍVEL - Preencha manualmente

# ========== JWT ==========
JWT_EXPIRES_IN= # Tempo de expiração do token | Tipo: string | ⚠️ OBRIGATÓRIO
JWT_SECRET_KEY= # Chave do token JWT | Tipo: string | ⚠️ OBRIGATÓRIO | 🔒 SENSÍVEL - Preencha manualmente

# Total: 16 variáveis | 5 obrigatórias | 2 sensíveis 🔒
